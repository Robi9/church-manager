# Backend (development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_manager?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=false

